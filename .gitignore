# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit these, they contain your database password
.env*
!.env.example
.env.local
.env.production

# uploaded PDFs — don't commit personal files to git
/public/uploads/*
!/public/uploads/.gitkeep

# local app data - keep personal library database off GitHub
/data/*
data.db
!/data/.gitkeep

# local run logs / process files
/.run/
*.log
next-start*.out.log
next-start*.err.log

# generated PWA workbox files
/public/workbox-*.js

# design-review screenshots (generated locally)
/design-review/screens/


# typescript
*.tsbuildinfo
next-env.d.ts
ecosystem.config.js

# local backups and editor/agent state
/backups/
.claude/
.cursor/
.codex/

# native build outputs
native/**/build/
native/**/.build/
native/**/dist/
native/**/bin/
native/**/obj/
native/**/.gradle/
native/**/xcuserdata/
native/**/local.properties
