{
  "name": "pdf-reader-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted PDF/EPUB reader and personal library with SQLite full-text search, annotations and E2EE uploads (Next.js).",
  "license": "MIT",
  "scripts": {
    "security:audit-encrypted-derivatives": "node scripts/audit-encrypted-derivatives.js",
    "dev": "next dev --webpack",
    "build": "node scripts/sync-pdf-worker.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "security:audit": "node scripts/security-audit.js",
    "security:deps": "node scripts/dependency-audit.js",
    "license:audit": "node scripts/license-audit.js",
    "monitor:health": "node scripts/monitor-health.js",
    "backup:safe": "node scripts/safe-backup.js",
    "invite:create": "node scripts/create-invite.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:shots": "node scripts/design-review-shots.mjs",
    "test:reader-accessibility": "node scripts/reader-accessibility-check.mjs",
    "typecheck": "tsc --noEmit",
    "user:create": "node scripts/create-user.js"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^1.11.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "perfect-freehand": "^1.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "react-pdf-highlighter-extended": "^8.1.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "pdfjs-dist": "5.4.296",
    "minimatch@^10.2.5": {
      "brace-expansion": "^5.0.8"
    },
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "minimatch@3.1.5": {
      ".": "10.2.6",
      "brace-expansion": "^5.0.8"
    }
  }
}
