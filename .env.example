# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Required in production ---------------------------------------------------
# Password for the bootstrap admin account (created/updated on startup).
PDF_LIBRARY_USERNAME=owner
PDF_LIBRARY_PASSWORD=change-me-strong-password
# Long random string used to HMAC-sign session cookies (e.g. `openssl rand -hex 32`).
PDF_LIBRARY_SESSION_SECRET=replace-with-64-random-hex-characters

# Public base URL of the deployment (used in emails and outbound User-Agent).
PUBLIC_APP_URL=http://localhost:3000

# The app always uses ./data/library.db; maintenance scripts accept PDF_LIBRARY_DB to override.
# PDF_LIBRARY_DB=./data/library.db

# --- Optional: test account (non-production is always on) --------------------
# ENABLE_TEST_ACCOUNT=false
# PDF_LIBRARY_TEST_PASSWORD=

# --- Optional: transactional email (Resend) -----------------------------------
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL=library@example.com

# --- Optional: AI / OCR / TTS / translation providers -------------------------
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# GOOGLE_TTS_API_KEY=
# GOOGLE_BOOKS_API_KEY=
# DEEPL_API_KEY=

# --- Optional: backups ---------------------------------------------------------
# BACKUP_LOCAL_DIR=./backups
# BACKUP_HOST_DIR=/var/backups/pdf-library
# BACKUP_LOCAL_KEEP=6
# BACKUP_HOST_KEEP=14
# BACKUP_ENCRYPTION_KEY=replace-with-random-secret
# Opt-in: restore an empty database from the newest archive in this directory on boot.
# BACKUP_RESTORE_DIR=
# S3-compatible off-site backups
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET_NAME=pdf-library-backups
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BACKUP_INTERVAL_HOURS=24

# --- Optional: networking --------------------------------------------------------
# Only set to 1 when the app is really behind Cloudflare.
# TRUST_CF_CONNECTING_IP=0
# Extra dev origins allowed by `next dev` (comma separated), e.g. 192.168.0.10
# DEV_ALLOWED_ORIGINS=

# --- Optional: native/API clients -------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=
